{
	admin off
	auto_https off
}

# Plain HTTP for local use. For a public server, replace ":8080" with your domain and
# Caddy fetches TLS certificates automatically.
:8080 {
	handle_path /valhalla/* {
		reverse_proxy valhalla:8002
	}

	handle_path /photon/* {
		reverse_proxy photon:2322
	}

	# Map tiles as {z}/{x}/{y}.mvt, cut from the PMTiles archive by the tiles service: plain URLs that
	# apps cache and download for offline use. The archive itself stays available for range
	# requests (pmtiles:// sources).
	handle_path /tiles/* {
		header Access-Control-Allow-Origin *
		@archive path *.pmtiles
		handle @archive {
			root * /srv/tiles
			file_server
		}
		handle {
			header Cache-Control "public, max-age=86400"
			reverse_proxy tiles:8080
		}
	}

	# Data packs: small JSON files the app downloads and revalidates (ETag).
	handle_path /datapacks/* {
		root * /srv/datapacks
		header Access-Control-Allow-Origin *
		encode gzip
		file_server
	}

	handle_path /assets/* {
		root * /srv/assets
		header Access-Control-Allow-Origin *
		file_server
	}

	# The report feed is JSON polled by every driver: compress it.
	handle /v1/reports* {
		encode gzip
		reverse_proxy server:8080
	}

	handle {
		reverse_proxy server:8080
	}
}
