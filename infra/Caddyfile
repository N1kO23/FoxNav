{
	admin off
	# HTTPS only where a site asks for it (the LAN site below), without redirects from plain HTTP.
	auto_https disable_redirects
	# Caddy's local CA lives in the container: installing it into the container's trust store is pointless.
	skip_install_trust
}

(foxnav) {
	handle_path /valhalla/* {
		reverse_proxy valhalla:8002
	}

	handle_path /photon/* {
		reverse_proxy photon:2322
	}

	# Map tiles as {z}/{x}/{y}.mvt, cut from the PMTiles archive by the tiles service: plain URLs that
	# apps cache and download for offline use. The archive itself stays available for range
	# requests (pmtiles:// sources).
	handle_path /tiles/* {
		header Access-Control-Allow-Origin *
		@archive path *.pmtiles
		handle @archive {
			root * /srv/tiles
			file_server
		}
		handle {
			header Cache-Control "public, max-age=86400"
			reverse_proxy tiles:8080
		}
	}

	# Data packs: small JSON files the app downloads and revalidates (ETag). A search pack's cells are
	# gzipped already, and fixed within a build, whose ID is in their path.
	handle_path /datapacks/* {
		root * /srv/datapacks
		header Access-Control-Allow-Origin *
		@cells path_regexp \.json\.gz$
		header @cells Cache-Control "public, max-age=31536000, immutable"
		encode gzip
		file_server
	}

	# The routing graph's tiles, for routing on the phone (protocol/SPEC.md §3.3): gzipped already,
	# and fixed within a build, whose ID is in their path. Only the manifest changes.
	handle_path /routing-tiles/* {
		root * /srv/routing-tiles
		header Access-Control-Allow-Origin *
		@manifest path /manifest.json
		handle @manifest {
			header Cache-Control no-cache
			encode gzip
			file_server
		}
		handle {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}

	handle_path /assets/* {
		root * /srv/assets
		header Access-Control-Allow-Origin *
		file_server
	}

	# The report feed is JSON polled by every driver: compress it.
	handle /v1/reports* {
		encode gzip
		reverse_proxy server:8080
	}

	handle {
		reverse_proxy server:8080
	}
}

# Plain HTTP for local use: this machine, the emulator, or a phone at http://<LAN IP>:8080.
:8080 {
	# The root certificate of Caddy's local CA, for devices to install so they trust the HTTPS site
	# below. Only this one file: the CA's private key sits in the same directory.
	handle /local-ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}

	import foxnav
}

# HTTPS for other devices on your network, at https://<FOXNAV_LAN_HOST>:8443 (set in infra/.env). Browsers
# follow convoys only on https pages. The certificate comes from Caddy's local CA, which each device
# trusts once (see README.md). For a public server, put your domain here instead (README.md).
{$FOXNAV_LAN_HOST:localhost}:8443 {
	tls internal
	import foxnav
}
